NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — profile sync + admin API (same as pipeline SUPABASE_SECRET_KEY)
SUPABASE_SECRET_KEY=your-secret-key

# Superuser — auto-approved on first login, sees Admin panel
SKIM_SUPERUSER_EMAIL=poudyal.sammit@gmail.com

# Shown on wait page + receives signup alert emails
SKIM_ADMIN_CONTACT_EMAIL=poudyal.sammit@gmail.com

# Public site URL for links in admin alert emails (optional)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: admin alert emails when someone signs up (same Mailtrap account as pipeline)
# MAILTRAP_API_TOKEN=...
# MAILTRAP_SENDER_EMAIL=digest@yourdomain.com
# MAILTRAP_SENDER_NAME=Skim

# RAG chat (server-only — same keys as pipeline)
# GEMINI_API_KEYS=key1,key2
# GEMINI_MODEL=gemini-2.0-flash
