SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Comma-separate multiple keys to rotate on quota exhaustion.
# Gemini keys must come from separate Google Cloud projects  -  the free tier
# meters quota per project, not per key.
GEMINI_API_KEYS=AIza...,AIza...,AIza...
GROQ_API_KEYS=gsk_...,gsk_...
# Optional: primary/fallback Gemini models and high-demand routing
# GEMINI_MODEL=gemini-3.6-flash
# Comma-separated fallbacks, tried in order after sustained 503/504 on primary
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-3.5-flash-lite
# Legacy single-fallback override (optional if GEMINI_FALLBACK_MODELS is set)
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# GEMINI_HIGH_DEMAND_THRESHOLD=3
# GEMINI_MODEL_RECOVERY_SECONDS=60
# Optional: faster Hugging Face model downloads for embeddings
HF_TOKEN=hf_...
# Optional: pipeline log verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
# Mailtrap  -  https://mailtrap.io
MAILTRAP_API_TOKEN=your-api-token
MAILTRAP_SENDER_EMAIL=skim@yourdomain.com
MAILTRAP_SENDER_NAME=Skim
# Superuser email (dashboard promotes to superuser on first login)
SKIM_SUPERUSER_EMAIL=you@email.com
DIGEST_RECIPIENT=your@email.com
# Local dev: capture emails in Mailtrap sandbox (no real delivery)
# MAILTRAP_SANDBOX=true
# MAILTRAP_INBOX_ID=1234567
# Local dev (IPv6): postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# GitHub Actions / IPv4-only: Dashboard → Connect → Transaction pooler (port 6543)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
